<Window x:Class="PowerPrompt.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PowerPrompt"
        Width="860" Height="560"
        MinWidth="640" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResize"
        ShowInTaskbar="True">

    <Window.Resources>
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextDim}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="11,0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="bar" Width="3" HorizontalAlignment="Left" Margin="0,8" CornerRadius="2"
                                    Background="{StaticResource Accent}" Visibility="Collapsed" />
                            <Border x:Name="b" CornerRadius="6" Background="Transparent" Margin="7,0,0,0"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource SurfaceHover}" />
                                <Setter Property="Foreground" Value="{StaticResource Text}" />
                            </Trigger>
                            <Trigger Property="Tag" Value="active">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource Surface}" />
                                <Setter TargetName="bar" Property="Visibility" Value="Visible" />
                                <Setter Property="Foreground" Value="{StaticResource Text}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource Bg}" CornerRadius="10" BorderBrush="{StaticResource Border}" BorderThickness="1">
        <DockPanel>
            <!-- Title bar -->
            <Grid x:Name="TitleBar" DockPanel.Dock="Top" Height="40" Background="Transparent"
                  MouseLeftButtonDown="TitleBar_MouseDown">
                <TextBlock Text="PowerPrompt" FontSize="13.5" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="16,0,0,0" Foreground="{StaticResource Text}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0">
                    <Button Style="{StaticResource IconButton}" Width="38" Height="28" Click="Minimize_Click" ToolTip="Minimize">
                        <Path Data="M 0 0 H 11" Stroke="{StaticResource TextDim}" StrokeThickness="1.4" />
                    </Button>
                    <Button Style="{StaticResource IconButton}" Width="38" Height="28" Click="Close_Click" ToolTip="Close to tray">
                        <Path Data="M 0 0 L 10 10 M 0 10 L 10 0" Stroke="{StaticResource TextDim}" StrokeThickness="1.4" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Body -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="158" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Sidebar -->
                <StackPanel Grid.Column="0" Margin="10,4,8,10">
                    <Button x:Name="NavLibrary" Style="{StaticResource NavButton}" Content="Library" Click="NavLibrary_Click" />
                    <Button x:Name="NavHistory" Style="{StaticResource NavButton}" Content="History" Click="NavHistory_Click" />
                    <Button x:Name="NavSettings" Style="{StaticResource NavButton}" Content="Settings" Click="NavSettings_Click" />
                </StackPanel>

                <!-- Content -->
                <Border Grid.Column="1" Background="{StaticResource Bg}" Margin="0,0,10,10">
                    <ContentControl x:Name="ContentHost" Margin="6,2,6,6" />
                </Border>
            </Grid>
        </DockPanel>
    </Border>
</Window>
