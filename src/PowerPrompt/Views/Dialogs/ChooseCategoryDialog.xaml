<Window x:Class="PowerPrompt.Views.Dialogs.ChooseCategoryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Move to category"
        Width="380"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="ToolWindow"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource Bg}">
    <StackPanel Margin="16">
        <TextBlock x:Name="PromptLabel" Text="Choose a category:" Margin="0,0,0,6" />
        <ComboBox x:Name="CategoryCombo" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="OkButton" Content="OK" Width="84" Height="28" IsDefault="True" Click="Ok_Click" />
            <Button Content="Cancel" Width="84" Height="28" Margin="8,0,0,0" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
